# ---------- Groq (server-side only; never sent to the browser) ----------
GROQ_API_KEY=your_groq_api_key
# llama-3.3-70b-versatile was retired by Groq on 2026-08-16.
# openai/gpt-oss-120b is Groq's recommended replacement.
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if GROQ_MODEL is unavailable / decommissioned
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---------- Server ----------
PORT=3000
# Only needed if the frontend is hosted on a different origin than this server
# CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=30

# ---------- Hindsight memory ----------
MEMORY_ENABLED=true
# Minimum relevance score (0-1) for a stored memory to be used as context
MEMORY_SIMILARITY_THRESHOLD=0.65
# Hindsight always uses exactly ONE memory (the single most relevant one) - there is no top-k setting
# Near-duplicate questions above this similarity are merged, not re-stored
MEMORY_DUPLICATE_THRESHOLD=0.88
# Use the LLM to extract structured error/cause/solution (falls back to heuristics)
MEMORY_LLM_EXTRACTION=true
# SQLite file (created automatically)
MEMORY_DB_PATH=./data/hindsight.db
